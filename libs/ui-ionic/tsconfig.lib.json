{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.stories.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "../gamification-engine/tsconfig.lib.json"
    },
    {
      "path": "../ui-core/tsconfig.lib.json"
    },
    {
      "path": "../i18n/tsconfig.lib.json"
    }
  ]
}
