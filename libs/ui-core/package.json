{
  "name": "@codify/ui-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@codify/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./format": {
      "@codify/source": "./src/lib/format/index.ts",
      "types": "./src/lib/format/index.ts",
      "import": "./src/lib/format/index.ts",
      "default": "./src/lib/format/index.ts"
    },
    "./level": {
      "@codify/source": "./src/lib/level/index.ts",
      "types": "./src/lib/level/index.ts",
      "import": "./src/lib/level/index.ts",
      "default": "./src/lib/level/index.ts"
    },
    "./validate": {
      "@codify/source": "./src/lib/validate/index.ts",
      "types": "./src/lib/validate/index.ts",
      "import": "./src/lib/validate/index.ts",
      "default": "./src/lib/validate/index.ts"
    },
    "./color": {
      "@codify/source": "./src/lib/color/index.ts",
      "types": "./src/lib/color/index.ts",
      "import": "./src/lib/color/index.ts",
      "default": "./src/lib/color/index.ts"
    },
    "./random": {
      "@codify/source": "./src/lib/random/index.ts",
      "types": "./src/lib/random/index.ts",
      "import": "./src/lib/random/index.ts",
      "default": "./src/lib/random/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "ui-core"
  },
  "dependencies": {
    "zod": "^4.4.2"
  },
  "sideEffects": false
