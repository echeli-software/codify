{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts",
    "**/*.stories.ts",
    "**/*.stories.js"
  ],
  "references": [
    {
      "path": "../lesson-schema/tsconfig.lib.json"
    },
    {
      "path": "../ui-core/tsconfig.lib.json"
    },
    {
      "path": "../ui-ionic/tsconfig.lib.json"
    },
    {
      "path": "../i18n/tsconfig.lib.json"
    }
  ]
}
