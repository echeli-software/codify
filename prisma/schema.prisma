// Phase 0 initial schema: User + AuditLog only.
// Full schema is specced in /docs/02-data-model.md; subsequent phases will
// migrate the rest in. Enable uuid-ossp + uuidv7 SQL function via the
// 0001_extensions migration before any table that uses uuid_generate_v7().

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  SUPPORT
  ADMIN
}

model User {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()"))
  clerkId             String    @unique
  email               String    @unique
  displayName         String
  locale              String    @default("pt-BR")
  timezone            String    @default("America/Sao_Paulo")
  role                UserRole  @default(STUDENT)
  /// Quiet-hours window in user-local minutes-from-midnight. Null = defaults
  /// (22:00–08:00). See /docs/10-engagement.md §3.
  quietHoursStart     Int?
  quietHoursEnd       Int?
  marketingEmailOptIn Boolean   @default(false)
  /// Public referral code (share link). Generated lazily. See /docs/18-growth.md.
  referralCode        String?   @unique
  /// The user who referred this account, if any.
  referredById        String?
  onboardedAt         DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  /// Account lifecycle (docs/14 §Privacy). Self-service deletion sets both
  /// `deletionRequestedAt` and `deletedAt`; the user may restore within 14
  /// days, and the row is anonymised (`purgedAt`) after 30. `deletedAt`
  /// alone (no request) means the auth provider deleted the account.
  deletionRequestedAt DateTime?
  purgedAt            DateTime?
  /// Admin suspension (docs/04 Users, docs/14 audit). Suspended accounts
  /// are refused by the API with ACCOUNT_SUSPENDED.
  suspendedAt         DateTime?
  suspendedReason     String?

  /// Notification settings (docs/10 §3). Null = defaults: 2 push/day,
  /// reminders at the learned session time (fallback 20:00 user-local).
  pushDailyCap      Int?
  /// Explicit opt-in to more than 14 pushes per week (docs/10 §3).
  pushWeeklyOptIn   Boolean   @default(false)
  /// Daily-quest reminder time, user-local minutes from midnight.
  reminderMinute    Int?
  /// Reactivation (docs/10 §13): last lapsed stage handled (0 none, 7, 14,
  /// 30) since the user was last active, and when they went dormant (90d).
  reactivationStage Int       @default(0)
  dormantAt         DateTime?

  /// Staff UI preference (docs/04 §7): light | dark | system | high-contrast.
  theme             String?
  /// Name of the starter pet given during onboarding (docs/10 §2, docs/08).
  petName           String?
  /// Opt-in: friends may see this user's learning activity (docs/05 Today).
  activityFeedOptIn Boolean   @default(false)
  /// Last-write-wins clock for avatarConfig (docs/16 §8).
  avatarUpdatedAt   DateTime?
  /// Onboarding goal (docs/10 §2): career | newTech | ai | softSkills.
  /// Drives "Recommended next" on every device.
  onboardingGoal    String?
  /// Date of birth (launch decision 2026-11: 12+). Set once by the user,
  /// corrected only by staff. Drives the minor (12–17) defaults.
  birthDate         DateTime? @db.Date
  /// ISO 3166-1 alpha-2 country from Cloudflare's CF-IPCountry header,
  /// refreshed at most daily on visits (launch decision 2026-11).
  country           String?
  countryUpdatedAt  DateTime?
  /// When the one-time "bonus event alerts?" prompt was shown (docs/10 §3).
  promoPromptedAt   DateTime?

  /// Running gamification totals — single-row updates from Progress
  /// completions inside the same transaction that writes Progress, so
  /// these two are always in sync. Source of truth: User row; Progress
  /// rows are the immutable journal.
  totalXp Int @default(0)
  coins   Int @default(0)

  /// AvatarConfig JSON (base body, skin tone, hair). See 08-avatar-and-shop.md.
  avatarConfig Json?

  auditedActions       AuditLog[]
  authoredCourses      Course[]                 @relation("CourseAuthor")
  progress             Progress[]
  subscriptions        Subscription[]
  xpEvents             XpEvent[]
  coinTransactions     CoinTransaction[]
  streak               Streak?
  deviceTokens         DeviceToken[]
  userBadges           UserBadge[]
  questAssignments     QuestAssignment[]
  items                UserItem[]
  avatarSlotTombstones AvatarSlotTombstone[]
  webPushSubscriptions WebPushSubscription[]
  guardianConsents     GuardianConsent[]
  reviewCards          ReviewCard[]
  equipped             EquippedItem[]
  leagueMemberships    LeagueMembership[]
  sentFriendRequests   FriendRequest[]          @relation("Sender")
  recvFriendRequests   FriendRequest[]          @relation("Receiver")
  friendshipsA         Friendship[]             @relation("FriendA")
  friendshipsB         Friendship[]             @relation("FriendB")
  sentNudges           FriendNudge[]            @relation("NudgeSender")
  recvNudges           FriendNudge[]            @relation("NudgeReceiver")
  submissions          Submission[]
  aiSubmissions        AiSubmission[]
  scenarioRuns         ScenarioRun[]
  certificates         Certificate[]
  enrollments          Enrollment[]
  quizAttempts         QuizAttempt[]
  uploadedAssets       Asset[]
  analyticsEvents      AnalyticsEvent[]
  referredBy           User?                    @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]                   @relation("Referrals")
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  payments             Payment[]
  promoRedemptions     PromoCodeRedemption[]
  coinBonusPools       CoinBonusPool[]
  multipliers          Multiplier[]

  @@index([role])
  @@index([lastSeenAt])
  @@index([country])
  @@index([referredById])
  @@index([deletedAt])
}

model AuditLog {
  id        String    @id @default(dbgenerated("uuid_generate_v7()"))
  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id])
  actorRole UserRole?
  action    String
  entity    String?
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

/// Catalog category — soft taxonomy for tagging courses and plans.
/// Phase 5b: ships with a single-locale `name` + `description`. The
/// polymorphic ContentTranslation table from /docs/02 §Translations
/// joins in Phase 5c.
model Category {
  id          String    @id @default(dbgenerated("uuid_generate_v7()"))
  slug        String    @unique
  name        String
  description String?
  /// References ICON_NAMES in libs/ui-bootstrap/atoms/icon (e.g. "gear").
  iconName    String?
  /// Codify color token (e.g. "primary", "success") from libs/ui-tokens.
  colorToken  String?
  /// Catalog ordering (docs/04 Catalog → Categories, drag to reorder).
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  courses CourseCategory[]
  plans   PlanCategory[]

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────
// Course / Module / Lesson — see /docs/02-data-model.md §"Catalog"
// ─────────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id               String       @id @default(dbgenerated("uuid_generate_v7()"))
  slug             String       @unique
  authorId         String
  author           User         @relation("CourseAuthor", fields: [authorId], references: [id])
  /// Locale the title/description in ContentTranslation-with-this-locale
  /// is the canonical source for. Other locales are translations.
  sourceLocale     String       @default("pt-BR")
  status           CourseStatus @default(DRAFT)
  difficulty       Int          @default(1) /// 1-5
  estimatedMinutes Int          @default(60)
  coverAssetId     String?
  /// A capstone course: a curated, multi-lesson project that issues a
  /// shareable certificate on completion. See /docs/18-growth.md.
  isCapstone       Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  modules      Module[]
  enrollments  Enrollment[]
  categories   CourseCategory[]
  multipliers  Multiplier[]
  certificates Certificate[]

  @@index([status, publishedAt])
  @@index([authorId])
}

model Module {
  id        String    @id @default(dbgenerated("uuid_generate_v7()"))
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete (docs/02 Conventions): lessons and student progress are kept.
  deletedAt DateTime?

  lessons Lesson[]

  @@unique([courseId, order])
}

enum LessonType {
  READING
  QUIZ
  EXERCISE
  AI_PROMPT
  SCENARIO
  /// Capstone project: a rubric-graded project submission (repo URL +
  /// write-up). Reuses the AiPrompt rubric machinery. See docs/18-growth.
  CAPSTONE
}

model Lesson {
  id               String     @id @default(dbgenerated("uuid_generate_v7()"))
  moduleId         String
  module           Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order            Int
  type             LessonType @default(READING)
  isFree           Boolean    @default(false)
  estimatedMinutes Int        @default(5)
  baseXp           Int        @default(10)
  baseCoins        Int        @default(5)
  /// Tiptap doc — see 06-content-authoring.md
  contentJson      Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  /// For EXERCISE lessons — the auto-graded coding exercise (1:1).
  exerciseId String?   @unique
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  /// For AI_PROMPT lessons — the rubric-graded prompt (1:1).
  aiPromptId String?   @unique
  aiPrompt   AiPrompt? @relation(fields: [aiPromptId], references: [id])

  /// For SCENARIO lessons — the branching dialogue (1:1).
  scenarioId String?   @unique
  scenario   Scenario? @relation(fields: [scenarioId], references: [id])

  progress     Progress[]
  multipliers  Multiplier[]
  quizAttempts QuizAttempt[]
  reviewCards  ReviewCard[]

  @@unique([moduleId, order])
  @@index([type])
}

/// Per-user, per-lesson completion record. Acts as the immutable journal
/// behind User.totalXp / User.coins running totals. Server enforces
/// uniqueness — replays of POST /lessons/:id/complete return the existing
/// row instead of double-awarding. Phase 5b will add a queued/synced flow
/// on top of this for offline (see /docs/16-offline.md).
model Progress {
  id           String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime @default(now())
  xpAwarded    Int
  coinsAwarded Int

  @@unique([userId, lessonId])
  @@index([userId, completedAt(sort: Desc)])
}

model CourseCategory {
  courseId   String
  categoryId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([courseId, categoryId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────
// Plans & subscriptions — see /docs/09-billing.md and /docs/02-data-model.md
// ─────────────────────────────────────────────────────────────────────

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

/// A purchasable subscription plan. `stripeProductId` is null until the
/// admin runs "Sync to Stripe" (Phase 6 dev-mode synthesizes a deterministic
/// fake id so the flow is exercisable without a real Stripe account).
/// Like Category, name/description are stored as direct single-locale columns
/// for now; ContentTranslation joins later.
model Plan {
  id                      String    @id @default(dbgenerated("uuid_generate_v7()"))
  slug                    String    @unique
  name                    String
  description             String?
  /// One-line marketing tagline shown on the paywall sheet.
  tagline                 String?
  stripeProductId         String?   @unique
  /// RevenueCat entitlement identifier (e.g. "all_access") this plan grants.
  /// Store webhooks map an entitlement back to the plan via this. See /docs/17-mobile.md.
  revenueCatEntitlementId String?   @unique
  /// Bypasses the category check — grants every published course.
  isAllAccess             Boolean   @default(false)
  isActive                Boolean   @default(true)
  sortOrder               Int       @default(0)
  /// Free-trial length applied at Checkout. See /docs/09-billing.md §9.
  trialDays               Int       @default(7)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  prices        PlanPrice[]
  categories    PlanCategory[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model PlanPrice {
  id              String        @id @default(dbgenerated("uuid_generate_v7()"))
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  stripePriceId   String?       @unique
  /// App Store / Play product identifier this price is sold as through
  /// RevenueCat (e.g. "codify_all_access_monthly"). See docs/17-mobile.
  storeProductId  String?       @unique
  /// ISO-4217, e.g. "BRL".
  currency        String
  amountCents     Int
  period          BillingPeriod
  /// Brazil parcelamento, up to 12. Null = no installments (monthly).
  maxInstallments Int?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([planId, currency, period])
  @@index([planId])
}

model PlanCategory {
  planId     String
  categoryId String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([planId, categoryId])
  @@index([categoryId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Provenance of a subscription. Prep for App Store / Play Billing via
/// RevenueCat (Phase 11). At launch only STRIPE_WEB / ADMIN_GRANT are used.
enum SubscriptionSource {
  STRIPE_WEB
  APPLE_IAP
  GOOGLE_PLAY
  ADMIN_GRANT
}

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v7()"))
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  source               SubscriptionSource @default(STRIPE_WEB)
  // Stripe-web subscriptions only — null for store (RevenueCat) subscriptions.
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  // Store (RevenueCat) subscriptions: the app-user id RevenueCat reports, and
  // the store's original transaction id — the stable identity across renewals
  // and the idempotent upsert key for IAP. See /docs/17-mobile.md §RevenueCat.
  revenueCatUserId     String?
  storeTransactionId   String?            @unique
  storeProductId       String?
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  /// Set when status first becomes PAST_DUE, cleared when it recovers.
  /// The access grace window is measured from here, not from
  /// currentPeriodEnd (which Stripe advances before the charge fails).
  pastDueSince         DateTime?
  /// `created` time of the newest Stripe event applied to this row. Older
  /// events arriving late (Stripe does not guarantee order) are ignored.
  lastStripeEventAt    DateTime?
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
  @@index([stripeCustomerId])
  @@index([revenueCatUserId])
}

// ─────────────────────────────────────────────────────────────────────
// Gamification — XP / coins / streaks / multipliers / badges / quests
// See /docs/07-gamification.md and /docs/02-data-model.md.
// ─────────────────────────────────────────────────────────────────────

enum XpSource {
  LESSON_COMPLETE
  QUIZ_PERFECT
  EXERCISE_PASS
  AI_PROMPT_PASS
  SCENARIO_COMPLETE
  STREAK_MILESTONE
  DAILY_QUEST
  BADGE_UNLOCK
  LEAGUE_PROMOTION
  ADMIN_GRANT
  CAPSTONE_PASS
  REFERRAL
  /// Exercise / AI-prompt re-pass, at most once per lesson per day (docs/07 §2).
  RETAKE
  /// A newly reached scenario ending (docs/07 §2).
  SCENARIO_BRANCH
}

/// Immutable XP journal. The user's current XP is SUM(amount); we also keep
/// User.totalXp as a running total updated in the same transaction.
model XpEvent {
  id             String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         XpSource
  amount         Int
  multiplier     Decimal  @db.Decimal(5, 2)
  refType        String?
  refId          String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

enum CoinSource {
  LESSON_COMPLETE
  QUIZ_PERFECT
  EXERCISE_PASS
  AI_PROMPT_PASS
  SCENARIO_COMPLETE
  STREAK_MILESTONE
  DAILY_QUEST
  WEEKLY_LEAGUE
  BADGE_UNLOCK
  CHEST_OPEN
  PURCHASE_REFUND
  PROMO_CODE
  ADMIN_GRANT
  ITEM_PURCHASE
  CHEST_PURCHASE
  CAPSTONE_PASS
  REFERRAL
  RETAKE
  SCENARIO_BRANCH
  /// Payout of coins held back by the daily per-source caps (docs/07 §5).
  WEEKLY_BONUS
}

/// Coin ledger — source of truth for the balance. `balanceAfter` is a
/// write-side denormalization so reads are O(1); the nightly drift check
/// verifies latest balanceAfter == SUM(delta) per user.
model CoinTransaction {
  id             String     @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta          Int
  source         CoinSource
  multiplier     Decimal?   @db.Decimal(5, 2)
  balanceAfter   Int
  refType        String?
  refId          String?
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// A registered push target (FCM/APNs token) for one user device. The student
/// app registers its token on login; streak reminders + reward pushes are
/// delivered here. See /docs/17-mobile.md §Push.
model DeviceToken {
  id         String         @id @default(dbgenerated("uuid_generate_v7()"))
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
}

/// One row per user. `lastActivityDate` is the user-local date (midnight) of
/// their last streak-satisfying action. Freezes auto-apply on a missed day.
model Streak {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDays      Int      @default(0)
  longestDays      Int      @default(0)
  freezesAvailable Int      @default(0)
  lastActivityDate DateTime
  updatedAt        DateTime @updatedAt
}

enum MultiplierKind {
  PREMIUM_DEFAULT
  /// Per-user, short-lived ("next 15 minutes 2x XP", docs/10 §6).
  SURPRISE_BOOST
  COURSE_PROMO
  LESSON_PROMO
  STREAK_TIER
  CAMPAIGN
}

enum MultiplierTarget {
  XP
  COINS
  BOTH
}

model Multiplier {
  id            String           @id @default(dbgenerated("uuid_generate_v7()"))
  kind          MultiplierKind
  target        MultiplierTarget @default(BOTH)
  value         Decimal          @db.Decimal(5, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  courseId      String?
  course        Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  streakDaysMin Int?
  /// Per-user multipliers (SURPRISE_BOOST, docs/10 §6).
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind, startsAt, endsAt])
  @@index([userId, endsAt])
}

model Badge {
  id          String   @id @default(dbgenerated("uuid_generate_v7()"))
  slug        String   @unique
  name        String
  description String?
  iconName    String?
  /// Uploaded icon (docs/02); iconName stays the fallback.
  iconAssetId String?
  /// BadgeRule DSL — see /docs/07-gamification.md §7.
  rule        Json
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  isHidden    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
  @@index([userId])
}

enum QuestKind {
  LESSON_COUNT
  CATEGORY_LESSON_COUNT
  XP_AMOUNT
  STREAK_MAINTAIN
  EXERCISE_PASS
}

model QuestTemplate {
  id         String    @id @default(dbgenerated("uuid_generate_v7()"))
  slug       String    @unique
  kind       QuestKind
  title      String
  /// Difficulty band for the weighted daily picker (one of each per day).
  difficulty Int       @default(1) /// 1=easy, 2=medium, 3=hard
  /// Relative weight inside its difficulty band for the daily picker.
  weight     Int       @default(1)
  target     Int
  paramsJson Json?
  coinReward Int       @default(0)
  xpReward   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignments QuestAssignment[]
}

model QuestAssignment {
  id          String        @id @default(dbgenerated("uuid_generate_v7()"))
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedFor DateTime
  progress    Int           @default(0)
  completedAt DateTime?

  @@unique([userId, templateId, assignedFor])
  @@index([userId, assignedFor])
}

/// Admin-editable config knobs (earning rates, caps, multiplier cap, etc.).
model GamificationConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
// Avatar & shop — see /docs/08-avatar-and-shop.md
// ─────────────────────────────────────────────────────────────────────

enum ItemSlot {
  PET
  BACKGROUND
  TOP
  BOTTOM
  SHOES
  HAT
  HAIR
  GLASSES
  ACCESSORY
  FRAME
  EMOTE
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// How an item entered an inventory (distinct from CoinSource).
enum ItemAcquisitionSource {
  PURCHASE
  CHEST
  ADMIN_GRANT
  PROMO
  ONBOARDING
  REFUND_RESTORE
}

model ItemCategory {
  slug      String   @id
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]
}

model Item {
  id               String       @id @default(dbgenerated("uuid_generate_v7()"))
  slug             String       @unique
  name             String
  description      String?
  slot             ItemSlot
  categorySlug     String
  category         ItemCategory @relation(fields: [categorySlug], references: [slug])
  rarity           ItemRarity   @default(COMMON)
  costCoins        Int          @default(0)
  requiredLevel    Int          @default(1)
  isPremiumOnly    Boolean      @default(false)
  isLimitedDrop    Boolean      @default(false)
  dropStartsAt     DateTime?
  dropEndsAt       DateTime?
  /// Placeholder sprite token until the SVG/R2 pipeline lands — e.g.
  /// "emoji:🎩" or "color:#88ccff". See 08-avatar-and-shop.md §3.
  spriteAssetId    String
  thumbnailAssetId String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  userItems     UserItem[]
  equippedItems EquippedItem[]

  @@index([slot, rarity])
  @@index([dropStartsAt, dropEndsAt])
}

model UserItem {
  id         String                @id @default(dbgenerated("uuid_generate_v7()"))
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item                  @relation(fields: [itemId], references: [id])
  source     ItemAcquisitionSource
  acquiredAt DateTime              @default(now())
  /// The user's own name for this item — pets (docs/08 §10).
  nickname   String?

  @@unique([userId, itemId])
  @@index([userId, acquiredAt])
}

model EquippedItem {
  userId    String
  slot      ItemSlot
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id])
  /// Last-write-wins clock for offline equips (docs/16 §8).
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, slot])
  @@index([userId])
}

/// An emptied avatar slot (docs/16 §8): an offline equip of this slot
/// queued before `clearedAt` must not win over the unequip.
model AvatarSlotTombstone {
  userId    String
  slot      ItemSlot
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clearedAt DateTime

  @@id([userId, slot])
}

// ─────────────────────────────────────────────────────────────────────
// Leagues — see /docs/07-gamification.md §9
// ─────────────────────────────────────────────────────────────────────

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model League {
  id        String     @id @default(dbgenerated("uuid_generate_v7()"))
  tier      LeagueTier
  /// UTC Monday 00:00.
  weekStart DateTime
  /// Shard key — scatters users into ~30-person cohorts.
  cohortKey String
  createdAt DateTime   @default(now())

  members LeagueMembership[]

  @@unique([tier, weekStart, cohortKey])
  @@index([weekStart])
  @@index([tier, weekStart])
}

model LeagueMembership {
  leagueId   String
  userId     String
  league     League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyXp   Int       @default(0)
  finalRank  Int?
  promoted   Boolean?
  demoted    Boolean?
  /// Set by the rollover job in the same tx that grants rewards — the
  /// idempotency token (retries skip rows where rewardedAt IS NOT NULL).
  rewardedAt DateTime?

  @@id([leagueId, userId])
  @@index([userId])
  @@index([leagueId, weeklyXp(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────
// Social — friends + nudges (see /docs/15-roadmap Phase 9)
// ─────────────────────────────────────────────────────────────────────

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model FriendRequest {
  id         String              @id @default(dbgenerated("uuid_generate_v7()"))
  senderId   String
  receiverId String
  sender     User                @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  @@index([receiverId, status])
  @@index([senderId, status])
}

/// Friendship is symmetric; convention userAId < userBId lexicographically.
model Friendship {
  userAId String
  userBId String
  userA   User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  since   DateTime @default(now())

  @@id([userAId, userBId])
  @@index([userBId])
}

/// Records each nudge for rate limiting (1 per friend per 24h).
model FriendNudge {
  id         String   @id @default(dbgenerated("uuid_generate_v7()"))
  senderId   String
  receiverId String
  sender     User     @relation("NudgeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("NudgeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// Exercises — auto-graded code (see /docs/12-code-execution.md)
// ─────────────────────────────────────────────────────────────────────

model Exercise {
  id               String   @id @default(dbgenerated("uuid_generate_v7()"))
  language         String /// "javascript" (dev executor) | "python" | …
  /// Function the tests call (data-driven harness: entryFunction(...args)).
  entryFunction    String   @default("solution")
  starterCode      String
  /// Reference solution — never sent to the client.
  solutionCode     String
  /// Optional custom harness; when empty the data-driven runner is used.
  testHarness      String   @default("")
  timeLimitMs      Int      @default(2000)
  memoryLimitKb    Int      @default(128000)
  /// [{ id, name, args, expected }] — visible in the UI.
  visibleTestsJson Json
  /// Same shape — hidden until the student passes.
  hiddenTestsJson  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lesson      Lesson?
  submissions Submission[]
}

enum SubmissionStatus {
  PENDING
  RUNNING
  COMPLETE
  WORKER_LOST
}

enum SubmissionVerdict {
  PASS
  FAIL
  ERROR
  TIMEOUT
  MEMORY
  RUNTIME
}

model Submission {
  id             String             @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId     String
  exercise       Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  code           String
  status         SubmissionStatus   @default(PENDING)
  verdict        SubmissionVerdict?
  runtimeMs      Int?
  memoryKb       Int?
  output         String?
  scorePct       Int?
  /// Whether this was a "submit" (scored, visible+hidden) vs a "run".
  scored         Boolean            @default(true)
  /// Per-test results as returned to the client (hidden tests anonymised
  /// until a pass), so a past submission can be shown again.
  resultJson     Json?
  idempotencyKey String?            @unique
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, exerciseId])
  @@index([exerciseId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────
// AI-prompt lessons — rubric-graded free-text (Phase 12) — docs/17-ai-grading
// ─────────────────────────────────────────────────────────────────────

enum GradedBy {
  HEURISTIC
  LLM
}

model AiPrompt {
  id            String   @id @default(dbgenerated("uuid_generate_v7()"))
  /// The task shown to the student.
  promptText    String
  /// Optional reference material shown alongside the prompt.
  contextText   String?
  /// Rubric criteria JSON: [{ id, label, weight, kind, config }] — see
  /// libs/domain ai-grading. `llm` criteria are graded by the provider.
  rubricJson    Json
  /// Passing score (weighted percent).
  passThreshold Int      @default(70)
  /// 0 = unlimited.
  maxAttempts   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson      Lesson?
  submissions AiSubmission[]
}

model AiSubmission {
  id            String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiPromptId    String
  aiPrompt      AiPrompt @relation(fields: [aiPromptId], references: [id], onDelete: Cascade)
  response      String
  scorePct      Int
  passed        Boolean
  /// Per-criterion results JSON ([{ id, label, weight, passed, detail }]).
  breakdownJson Json
  gradedBy      GradedBy @default(HEURISTIC)
  /// True when served from the identical-response cache (no re-grade).
  cached        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, aiPromptId])
  @@index([aiPromptId])
}

// ─────────────────────────────────────────────────────────────────────
// Scenario lessons — branching dialogue (Phase 12) — docs/17-ai-grading
// ─────────────────────────────────────────────────────────────────────

model Scenario {
  id        String   @id @default(dbgenerated("uuid_generate_v7()"))
  /// Graph JSON: { startId, nodes: { [id]: { id, speaker, text,
  /// choices: [{ id, label, to, ending?, outcome? }] } } }.
  graphJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson?
  runs   ScenarioRun[]
}

model ScenarioRun {
  id         String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  /// Ordered choice ids the student took.
  pathJson   Json
  /// Number of choices made (branch depth reached).
  maxDepth   Int      @default(0)
  completed  Boolean  @default(false)
  outcome    String?
  createdAt  DateTime @default(now())

  @@index([userId, scenarioId])
  @@index([scenarioId])
}

// ─────────────────────────────────────────────────────────────────────
// Certificates — issued on course completion (Phase 13) — docs/18-growth
// ─────────────────────────────────────────────────────────────────────

model Certificate {
  id            String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Public, verifiable code (e.g. "CDFY-AB12-CD34") — the verify URL key.
  serial        String   @unique
  /// Snapshots taken at issue time so the certificate is stable if the
  /// display name / course title later change.
  recipientName String
  courseTitle   String
  isCapstone    Boolean  @default(false)
  issuedAt      DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

/// Long-term idempotency ledger for critical billing/gamification paths.
/// Redis is the hot-path cache (later); Postgres is authoritative — the
/// unique `key` guarantees no double-execution. Used by the Stripe webhook
/// handler to drop duplicate event deliveries. See /docs/02 §IdempotencyRecord.
model IdempotencyRecord {
  key          String   @id
  /// e.g. "stripe_webhook", "lesson_complete".
  scope        String
  userId       String?
  responseHash String?
  createdAt    DateTime @default(now())

  @@index([scope, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// Translations (content-level) — see /docs/02-data-model.md §"Translations"
// ─────────────────────────────────────────────────────────────────────

/// docs/11 §Content: every entity with user-facing text.
enum TranslatableEntity {
  COURSE
  MODULE
  LESSON
  CATEGORY
  PLAN
  BADGE
  ITEM
  ITEM_CATEGORY
  QUEST
}

/// Polymorphic translations table. Tried Prisma named relations
/// (Course/Module/Lesson/Category) — they collapse to four real FK
/// constraints on the same column, so every insert had to satisfy
/// all four targets simultaneously. Dropped the relations; entityId
/// is just a string. Cascade deletes happen at the application layer
/// when an entity is hard-deleted (we soft-delete day-to-day, so this
/// rarely matters).
model ContentTranslation {
  id         String             @id @default(dbgenerated("uuid_generate_v7()"))
  entityType TranslatableEntity
  entityId   String
  locale     String
  /// e.g. "title", "description", "contentJson"
  field      String
  /// JSON-encoded if `field` represents a JSON column.
  value      String
  /// Marked true when the source-locale changed after this translation
  /// was last touched. Surfaces in the admin Translation workspace.
  outdated   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────
// Enrollment — explicit course membership (docs/09-billing §3 step 3).
// Drives "My courses", auto-download of enrolled courses (docs/16) and
// PROMO / ADMIN_GRANT access that bypasses subscriptions.
// ─────────────────────────────────────────────────────────────────────

enum EnrollmentSource {
  SELF
  PROMO
  ADMIN_GRANT
}

model Enrollment {
  id          String           @id @default(dbgenerated("uuid_generate_v7()"))
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source      EnrollmentSource @default(SELF)
  /// PROMO / ADMIN_GRANT enrollments grant paid access until this time
  /// (null = no expiry). SELF enrollments never grant paid access.
  accessUntil DateTime?
  createdAt   DateTime         @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// ─────────────────────────────────────────────────────────────────────
// Quiz attempts — graded server-side from the lesson's quiz blocks.
// ─────────────────────────────────────────────────────────────────────

model QuizAttempt {
  id          String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// { [quizBlockId]: selectedOptionIds[] }
  answersJson Json
  scorePct    Int
  passed      Boolean
  createdAt   DateTime @default(now())

  @@index([userId, lessonId])
}

// ─────────────────────────────────────────────────────────────────────
// Assets — uploaded media (R2 / S3-compatible). docs/06 §images, docs/08.
// ─────────────────────────────────────────────────────────────────────

enum AssetKind {
  IMAGE
  SPRITE
  COVER
  OTHER
}

model Asset {
  id           String    @id @default(dbgenerated("uuid_generate_v7()"))
  /// Object key in the bucket, e.g. "images/2026/10/<uuid>.png".
  key          String    @unique
  /// Public CDN URL the clients render.
  url          String
  mimeType     String
  sizeBytes    Int
  /// Content hash (dedupe + integrity, docs/02).
  sha256       String?   @unique
  width        Int?
  height       Int?
  kind         AssetKind @default(IMAGE)
  /// False until the client confirms the PUT to the presigned URL landed.
  confirmed    Boolean   @default(false)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([kind, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// AI grading cache — identical responses to the same prompt are graded
// once, across users (docs/17-ai-grading §caching).
// ─────────────────────────────────────────────────────────────────────

model AiGradeCache {
  id            String   @id @default(dbgenerated("uuid_generate_v7()"))
  aiPromptId    String
  /// sha256 of the normalised response text.
  responseHash  String
  scorePct      Int
  passed        Boolean
  breakdownJson Json
  gradedBy      GradedBy
  /// Invalidate when the prompt's rubric changes.
  rubricHash    String
  createdAt     DateTime @default(now())

  @@unique([aiPromptId, responseHash, rubricHash])
}

// ─────────────────────────────────────────────────────────────────────
// Product analytics — first-party event log (docs/10-engagement,
// docs/14 §12 "we do our own analytics").
// ─────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Stable per-install id for pre-login events.
  anonymousId String?
  /// snake_case event name, e.g. "lesson_completed", "download_started".
  name        String
  props       Json?
  platform    String?
  appVersion  String?
  /// Client clock time of the event; createdAt is server receipt.
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────
// Notifications — in-app inbox + delivery log — docs/10 §3, docs/05 §3
// ─────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationKind {
  STREAK_REMINDER
  DAILY_QUEST
  FRIEND_NUDGE
  LEAGUE_RESULT
  ITEM_DROP
  PROMO
  BILLING
  SYSTEM
  WELCOME
  WEEKLY_RECAP
  REACTIVATION
}

/// One row per notification per channel. IN_APP rows are the inbox (read via
/// `readAt`); PUSH/EMAIL rows are the delivery log (`sentAt` once delivered,
/// `scheduledFor` while deferred to the end of quiet hours).
model Notification {
  id           String              @id @default(dbgenerated("uuid_generate_v7()"))
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  kind         NotificationKind
  /// { title, body, deepLink?, action?: { type, label?, ref? }, data? }
  payload      Json
  scheduledFor DateTime?
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([userId, channel, createdAt])
  @@index([userId, readAt])
  @@index([scheduledFor])
  @@index([userId, scheduledFor])
}

/// Per-kind delivery settings. No row = defaults (push + email on, except
/// PROMO push which is opt-in). `fewerLevel` is the "fewer like this"
/// feedback: 0 normal, 1 fewer, 2 much fewer.
model NotificationPreference {
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         NotificationKind
  pushEnabled  Boolean          @default(true)
  emailEnabled Boolean          @default(true)
  fewerLevel   Int              @default(0)
  updatedAt    DateTime         @updatedAt

  @@id([userId, kind])
}

// ─────────────────────────────────────────────────────────────────────
// Payments — billing history + refunds — docs/09 §6, docs/05 Subscription
// ─────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  STRIPE
  APPLE
  GOOGLE
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id             String          @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider       PaymentProvider
  /// Stripe invoice id / store transaction id — the idempotent upsert key.
  externalId     String          @unique
  amountCents    Int
  currency       String
  status         PaymentStatus
  /// card | pix | boleto | store
  method         String?
  refundedCents  Int             @default(0)
  /// Hosted invoice / receipt URL when the provider has one.
  receiptUrl     String?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

// ─────────────────────────────────────────────────────────────────────
// Feature flags + experiments — docs/10 §9, docs/04 Settings
// ─────────────────────────────────────────────────────────────────────

/// Server-side feature flags. Read-mostly; changes audited.
/// `value`: { enabled: boolean, rolloutPct?: 0-100, variants?: { key: weight },
/// holdoutPct?: 0-100, surface?: string }. Rollout and variant are chosen
/// deterministically from hash(userId, key).
model FeatureFlag {
  key         String   @id /// e.g. "leagues.enabled", "shop.enabled"
  value       Json
  description String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────
// Coin promo codes + weekly bonus pool — docs/08 §12, docs/07 §5
// ─────────────────────────────────────────────────────────────────────

/// Campaign codes that grant coins once per user (CoinSource.PROMO_CODE).
model PromoCode {
  id             String                @id @default(dbgenerated("uuid_generate_v7()"))
  /// Stored upper-case; redeemed case-insensitively.
  code           String                @unique
  coins          Int
  maxRedemptions Int?
  redemptions    Int                   @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean               @default(true)
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  redeemedBy     PromoCodeRedemption[]
}

model PromoCodeRedemption {
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([promoCodeId, userId])
  @@index([userId])
}

/// Coins over a daily per-source cap accrue here for the user's week
/// (capped by config) and are paid as CoinSource.WEEKLY_BONUS when the week
/// closes (docs/07 §5).
model CoinBonusPool {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  coins     Int       @default(0)
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@id([userId, weekStart])
  @@index([weekStart, paidAt])
}

/// Spaced-repetition review of a completed lesson (docs/10 §7): Leitner
/// box 1–5; a pass moves it up a box and pushes `dueAt` out, a miss drops
/// it to box 1. Mastery (GOLD) needs the topic's cards reviewed.
model ReviewCard {
  id             String    @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  box            Int       @default(1)
  dueAt          DateTime
  reviews        Int       @default(0)
  lapses         Int       @default(0)
  lastResult     Boolean?
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId, dueAt])
}

/// A browser Web Push subscription (VAPID) for the PWA (docs/10 §3). Native
/// apps use DeviceToken (FCM/APNs) instead.
model WebPushSubscription {
  id         String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// A parent / guardian's confirmation for a minor's (12–17) paid plan
/// (launch decision 2026-11). Recorded before web checkout.
model GuardianConsent {
  id            String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianName  String
  guardianEmail String
  purpose       String
  planPriceId   String?
  ip            String?
  userAgent     String?
  confirmedAt   DateTime @default(now())

  @@index([userId, confirmedAt])
}
