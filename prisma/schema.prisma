// Phase 0 initial schema: User + AuditLog only.
// Full schema is specced in /docs/02-data-model.md; subsequent phases will
// migrate the rest in. Enable uuid-ossp + uuidv7 SQL function via the
// 0001_extensions migration before any table that uses uuid_generate_v7().

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  SUPPORT
  ADMIN
}

model User {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()"))
  clerkId             String    @unique
  email               String    @unique
  displayName         String
  locale              String    @default("pt-BR")
  timezone            String    @default("America/Sao_Paulo")
  role                UserRole  @default(STUDENT)
  /// Quiet-hours window in user-local minutes-from-midnight. Null = defaults
  /// (22:00–08:00). See /docs/10-engagement.md §3.
  quietHoursStart     Int?
  quietHoursEnd       Int?
  marketingEmailOptIn Boolean   @default(false)
  onboardedAt         DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  /// Running gamification totals — single-row updates from Progress
  /// completions inside the same transaction that writes Progress, so
  /// these two are always in sync. Source of truth: User row; Progress
  /// rows are the immutable journal.
  totalXp             Int       @default(0)
  coins               Int       @default(0)

  auditedActions  AuditLog[]
  authoredCourses Course[]   @relation("CourseAuthor")
  progress        Progress[]
  subscriptions   Subscription[]
  xpEvents         XpEvent[]
  coinTransactions CoinTransaction[]
  streak           Streak?
  userBadges       UserBadge[]
  questAssignments QuestAssignment[]

  @@index([role])
  @@index([lastSeenAt])
}

model AuditLog {
  id        String    @id @default(dbgenerated("uuid_generate_v7()"))
  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id])
  actorRole UserRole?
  action    String
  entity    String?
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

/// Catalog category — soft taxonomy for tagging courses and plans.
/// Phase 5b: ships with a single-locale `name` + `description`. The
/// polymorphic ContentTranslation table from /docs/02 §Translations
/// joins in Phase 5c.
model Category {
  id          String   @id @default(dbgenerated("uuid_generate_v7()"))
  slug        String   @unique
  name        String
  description String?
  /// References ICON_NAMES in libs/ui-bootstrap/atoms/icon (e.g. "gear").
  iconName    String?
  /// Codify color token (e.g. "primary", "success") from libs/ui-tokens.
  colorToken  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  courses CourseCategory[]
  plans   PlanCategory[]

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────
// Course / Module / Lesson — see /docs/02-data-model.md §"Catalog"
// ─────────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id               String       @id @default(dbgenerated("uuid_generate_v7()"))
  slug             String       @unique
  authorId         String
  author           User         @relation("CourseAuthor", fields: [authorId], references: [id])
  /// Locale the title/description in ContentTranslation-with-this-locale
  /// is the canonical source for. Other locales are translations.
  sourceLocale     String       @default("pt-BR")
  status           CourseStatus @default(DRAFT)
  difficulty       Int          @default(1) /// 1-5
  estimatedMinutes Int          @default(60)
  coverAssetId     String?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  modules     Module[]
  categories  CourseCategory[]
  multipliers Multiplier[]

  @@index([status, publishedAt])
  @@index([authorId])
}

model Module {
  id        String   @id @default(dbgenerated("uuid_generate_v7()"))
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, order])
}

enum LessonType {
  READING
  QUIZ
  EXERCISE
  AI_PROMPT
  SCENARIO
}

model Lesson {
  id               String     @id @default(dbgenerated("uuid_generate_v7()"))
  moduleId         String
  module           Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order            Int
  type             LessonType @default(READING)
  isFree           Boolean    @default(false)
  estimatedMinutes Int        @default(5)
  baseXp           Int        @default(10)
  baseCoins        Int        @default(5)
  /// Tiptap doc — see 06-content-authoring.md
  contentJson      Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  @@unique([moduleId, order])
  @@index([type])

  progress    Progress[]
  multipliers Multiplier[]
}

/// Per-user, per-lesson completion record. Acts as the immutable journal
/// behind User.totalXp / User.coins running totals. Server enforces
/// uniqueness — replays of POST /lessons/:id/complete return the existing
/// row instead of double-awarding. Phase 5b will add a queued/synced flow
/// on top of this for offline (see /docs/16-offline.md).
model Progress {
  id           String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime @default(now())
  xpAwarded    Int
  coinsAwarded Int

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model CourseCategory {
  courseId   String
  categoryId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([courseId, categoryId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────
// Plans & subscriptions — see /docs/09-billing.md and /docs/02-data-model.md
// ─────────────────────────────────────────────────────────────────────

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

/// A purchasable subscription plan. `stripeProductId` is null until the
/// admin runs "Sync to Stripe" (Phase 6 dev-mode synthesizes a deterministic
/// fake id so the flow is exercisable without a real Stripe account).
/// Like Category, name/description are stored as direct single-locale columns
/// for now; ContentTranslation joins later.
model Plan {
  id              String   @id @default(dbgenerated("uuid_generate_v7()"))
  slug            String   @unique
  name            String
  description     String?
  /// One-line marketing tagline shown on the paywall sheet.
  tagline         String?
  stripeProductId String?  @unique
  /// Bypasses the category check — grants every published course.
  isAllAccess     Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  /// Free-trial length applied at Checkout. See /docs/09-billing.md §9.
  trialDays       Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  prices        PlanPrice[]
  categories    PlanCategory[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model PlanPrice {
  id              String        @id @default(dbgenerated("uuid_generate_v7()"))
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  stripePriceId   String?       @unique
  /// ISO-4217, e.g. "BRL".
  currency        String
  amountCents     Int
  period          BillingPeriod
  /// Brazil parcelamento, up to 12. Null = no installments (monthly).
  maxInstallments Int?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([planId, currency, period])
  @@index([planId])
}

model PlanCategory {
  planId     String
  categoryId String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([planId, categoryId])
  @@index([categoryId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Provenance of a subscription. Prep for App Store / Play Billing via
/// RevenueCat (Phase 11). At launch only STRIPE_WEB / ADMIN_GRANT are used.
enum SubscriptionSource {
  STRIPE_WEB
  APPLE_IAP
  GOOGLE_PLAY
  ADMIN_GRANT
}

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v7()"))
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  source               SubscriptionSource @default(STRIPE_WEB)
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
  @@index([stripeCustomerId])
}

// ─────────────────────────────────────────────────────────────────────
// Gamification — XP / coins / streaks / multipliers / badges / quests
// See /docs/07-gamification.md and /docs/02-data-model.md.
// ─────────────────────────────────────────────────────────────────────

enum XpSource {
  LESSON_COMPLETE
  QUIZ_PERFECT
  EXERCISE_PASS
  STREAK_MILESTONE
  DAILY_QUEST
  BADGE_UNLOCK
  LEAGUE_PROMOTION
  ADMIN_GRANT
}

/// Immutable XP journal. The user's current XP is SUM(amount); we also keep
/// User.totalXp as a running total updated in the same transaction.
model XpEvent {
  id             String   @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         XpSource
  amount         Int
  multiplier     Decimal  @db.Decimal(5, 2)
  refType        String?
  refId          String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

enum CoinSource {
  LESSON_COMPLETE
  QUIZ_PERFECT
  EXERCISE_PASS
  STREAK_MILESTONE
  DAILY_QUEST
  WEEKLY_LEAGUE
  BADGE_UNLOCK
  CHEST_OPEN
  PURCHASE_REFUND
  PROMO_CODE
  ADMIN_GRANT
  ITEM_PURCHASE
  CHEST_PURCHASE
}

/// Coin ledger — source of truth for the balance. `balanceAfter` is a
/// write-side denormalization so reads are O(1); the nightly drift check
/// verifies latest balanceAfter == SUM(delta) per user.
model CoinTransaction {
  id             String     @id @default(dbgenerated("uuid_generate_v7()"))
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta          Int
  source         CoinSource
  multiplier     Decimal?   @db.Decimal(5, 2)
  balanceAfter   Int
  refType        String?
  refId          String?
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

/// One row per user. `lastActivityDate` is the user-local date (midnight) of
/// their last streak-satisfying action. Freezes auto-apply on a missed day.
model Streak {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDays      Int      @default(0)
  longestDays      Int      @default(0)
  freezesAvailable Int      @default(0)
  lastActivityDate DateTime
  updatedAt        DateTime @updatedAt
}

enum MultiplierKind {
  PREMIUM_DEFAULT
  COURSE_PROMO
  LESSON_PROMO
  STREAK_TIER
  CAMPAIGN
}

enum MultiplierTarget {
  XP
  COINS
  BOTH
}

model Multiplier {
  id            String           @id @default(dbgenerated("uuid_generate_v7()"))
  kind          MultiplierKind
  target        MultiplierTarget @default(BOTH)
  value         Decimal          @db.Decimal(5, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  courseId      String?
  course        Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  streakDaysMin Int?
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind, startsAt, endsAt])
}

model Badge {
  id          String   @id @default(dbgenerated("uuid_generate_v7()"))
  slug        String   @unique
  name        String
  description String?
  iconName    String?
  /// BadgeRule DSL — see /docs/07-gamification.md §7.
  rule        Json
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  isHidden    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
  @@index([userId])
}

enum QuestKind {
  LESSON_COUNT
  CATEGORY_LESSON_COUNT
  XP_AMOUNT
  STREAK_MAINTAIN
  EXERCISE_PASS
}

model QuestTemplate {
  id         String    @id @default(dbgenerated("uuid_generate_v7()"))
  slug       String    @unique
  kind       QuestKind
  title      String
  /// Difficulty band for the weighted daily picker (one of each per day).
  difficulty Int       @default(1) /// 1=easy, 2=medium, 3=hard
  target     Int
  paramsJson Json?
  coinReward Int       @default(0)
  xpReward   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignments QuestAssignment[]
}

model QuestAssignment {
  id          String        @id @default(dbgenerated("uuid_generate_v7()"))
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedFor DateTime
  progress    Int           @default(0)
  completedAt DateTime?

  @@unique([userId, templateId, assignedFor])
  @@index([userId, assignedFor])
}

/// Admin-editable config knobs (earning rates, caps, multiplier cap, etc.).
model GamificationConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Long-term idempotency ledger for critical billing/gamification paths.
/// Redis is the hot-path cache (later); Postgres is authoritative — the
/// unique `key` guarantees no double-execution. Used by the Stripe webhook
/// handler to drop duplicate event deliveries. See /docs/02 §IdempotencyRecord.
model IdempotencyRecord {
  key          String   @id
  /// e.g. "stripe_webhook", "lesson_complete".
  scope        String
  userId       String?
  responseHash String?
  createdAt    DateTime @default(now())

  @@index([scope, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// Translations (content-level) — see /docs/02-data-model.md §"Translations"
// ─────────────────────────────────────────────────────────────────────

enum TranslatableEntity {
  COURSE
  MODULE
  LESSON
  CATEGORY
}

/// Polymorphic translations table. Tried Prisma named relations
/// (Course/Module/Lesson/Category) — they collapse to four real FK
/// constraints on the same column, so every insert had to satisfy
/// all four targets simultaneously. Dropped the relations; entityId
/// is just a string. Cascade deletes happen at the application layer
/// when an entity is hard-deleted (we soft-delete day-to-day, so this
/// rarely matters).
model ContentTranslation {
  id         String             @id @default(dbgenerated("uuid_generate_v7()"))
  entityType TranslatableEntity
  entityId   String
  locale     String
  /// e.g. "title", "description", "contentJson"
  field      String
  /// JSON-encoded if `field` represents a JSON column.
  value      String
  /// Marked true when the source-locale changed after this translation
  /// was last touched. Surfaces in the admin Translation workspace.
  outdated   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId])
}
