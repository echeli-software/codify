# Grafana Cloud → Connections → Hosted logs / Hosted metrics show these values.
CODIFY_ENV=prod
GRAFANA_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
GRAFANA_PROM_URL=https://prometheus-prod-00-prod-sa-east-1.grafana.net/api/prom/push
GRAFANA_PROM_USER=000000
# Access policy token with logs:write + metrics:write scopes.
GRAFANA_CLOUD_API_KEY=
