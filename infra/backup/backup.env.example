# /etc/codify/backup.env on vps-app-01 (prod) / vps-staging-01 (staging),
# owner root, mode 600. Read by the weekly cron (codify-pg-backup.cron).
# No secrets in the repo: fill the values on the host from 1Password.
DATABASE_URL=
# Public key only — the matching private key stays in 1Password ("Codify DB backup age key").
AGE_RECIPIENTS=age1replace-with-the-public-key
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=codify-backups
# R2 API token with Object Read & Write on codify-backups only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_PREFIX=prod
BACKUP_RETENTION_DAYS=90
# Optional dead-man's switch (e.g. a Grafana / healthchecks.io check URL).
BACKUP_HEARTBEAT_URL=
