# Copy to .env (gitignored) and fill in values for local dev.
# Production values live in Coolify env vars.

# ─── Database ────────────────────────────────────────────────────────────────
# Host port 55432 (compose maps 55432→5432) so codify coexists with other
# projects' Postgres containers on the default 5432.
DATABASE_URL=postgresql://codify:codify@localhost:55432/codify_dev?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Accept `Authorization: Bearer dev-token-<role>` (dev role picker). Ignored —
# and rejected at boot — when NODE_ENV=production.
ALLOW_DEV_AUTH=true

# ─── Clerk (sign up at clerk.com, create a dev tenant) ───────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# ─── Stripe (test mode) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudflare R2 (S3-compatible) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codify-dev-assets
R2_PUBLIC_URL=https://cdn.codify.local

# ─── Sentry (optional in dev) ────────────────────────────────────────────────
SENTRY_DSN=

# ─── Judge0 (added in phase 10) ──────────────────────────────────────────────
# JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=

# ─── Billing (Stripe / RevenueCat) — docs/09, docs/17-mobile ─────────────────
# STRIPE_SECRET_KEY (above) selects the real Stripe provider and then also
# requires STRIPE_WEBHOOK_SECRET. In production both are required: the API
# refuses to boot without them (no silent fallback to the dev provider).
# HMAC key for dev checkout session ids (dev provider only; random per
# process when unset, so dev sessions die with a restart).
# DEV_BILLING_SECRET=
# Shared Authorization header value configured in the RevenueCat dashboard
# webhook. Required in production.
# REVENUECAT_WEBHOOK_AUTH=

# ─── Engagement (gamification jobs, referrals) ──────────────────────────────
# Scheduled jobs in this area (league rollover, quest pre-assignment,
# referral rewards, limited-drop announcements). Set to false on extra API
# replicas or locally; jobs never run under jest.
JOBS_ENABLED=true
# Base URL of the student app; referral/friend-invite links are <url>/r/<code>.
STUDENT_APP_URL=http://localhost:4202

# ─── Learning: code execution, submissions, AI grading ──────────────────────
# Code execution (docs/12). JUDGE0_URL (+ JUDGE0_AUTH_TOKEN, sent as
# X-Auth-Token) is REQUIRED in production; without it dev runs JS/TS in a
# sandboxed local Node child process (Python needs Judge0).
# Language ids default to Judge0 CE 1.13 (Node 18 = 93, TS 5 = 94, Python 3.11 = 92);
# override for custom images — check GET /languages on the Judge0 host.
# JUDGE0_LANGUAGE_IDS=javascript:93,typescript:94,python:92
# Submissions queue on BullMQ over REDIS_URL (REQUIRED in production; dev
# falls back to inline execution when Redis is down).
# BULLMQ_PREFIX=codify
# SUBMISSION_WORKER_CONCURRENCY=4
# SUBMISSION_WAIT_MS=10000
# SUBMISSION_STALE_MS=120000
# AI-prompt grading (docs/17). ANTHROPIC_API_KEY is REQUIRED in production;
# without it dev uses the deterministic heuristic grader.
# ANTHROPIC_API_KEY=
# AI_GRADER_MODEL=claude-haiku-4-5-20251001
# AI_GRADER_TIMEOUT_MS=8000

# ─── Platform: auth, HTTP hardening, observability, push, jobs ──────────────
# Validated at boot by apps/api/src/app/config/env.schema.ts; production refuses
# to start when a required value below is missing.
# Clerk — CLERK_SECRET_KEY (above) is required in production; CLERK_JWT_KEY (PEM)
# enables networkless JWT verification.
# Origins allowed in the session token's `azp` claim (comma list). Required in prod.
CLERK_AUTHORIZED_PARTIES=http://localhost:4201,http://localhost:4202
# Svix signing secret of the Clerk webhook endpoint (POST /api/webhooks/clerk). Required in prod.
CLERK_WEBHOOK_SIGNING_SECRET=
# Browser origins allowed by CORS (comma list). Dev default: localhost 4201/4202/4400/4401.
# Production: https://codify.app,https://app.codify.app,https://admin.codify.app,capacitor://localhost,https://localhost
CORS_ORIGINS=
# Express `trust proxy`: hop count (1 = Cloudflare → API, 2 = Cloudflare → Coolify proxy → API),
# true/false, or trusted subnets. Default: 1 in production, loopback otherwise.
TRUST_PROXY=
# Sentry (SENTRY_DSN above): environment + release tags, optional tracing sample rate.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# pino level: fatal|error|warn|info|debug|trace|silent (default: info in prod, debug in dev).
LOG_LEVEL=
# Base64 of the Firebase service-account JSON (FCM push for Android/web, iOS via APNs bridge).
# Unset in dev → DevPushProvider captures pushes. Required in prod.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Scheduled jobs (streak reminders hourly, ledger drift nightly). Never run under jest.
JOBS_ENABLED=true
# Rate limits per docs/14 §7 (Redis-backed when REDIS_URL is set). Set false only in dev for
# burst-y seed/probe scripts; production refuses to boot with false.
THROTTLE_ENABLED=true
