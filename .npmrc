# Hoist Tiptap packages so all extensions share the same @tiptap/core type
# instance — without this, pnpm's nested resolution creates duplicate
# @tiptap/core copies and TypeScript fails with
# "Two different types with this name exist, but they are unrelated."
public-hoist-pattern[]=@tiptap/*

# The generated Prisma client (node_modules/.prisma) requires
# @prisma/client-runtime-utils, which pnpm would otherwise keep nested, so
# `node apps/api/dist/main.js` failed with "Cannot find module".
public-hoist-pattern[]=@prisma/*
